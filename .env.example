# DDNet Panel 环境变量配置
# 复制此文件为 .env 并修改

# 面板端口
PANEL_PORT=8400

# 管理员密码 (不设置则自动生成随机密码)
# PANEL_PASSWORD=your-password-here

# JWT 密钥 (不设置则自动生成随机密钥)
# JWT_SECRET=your-secret-here

# DDNet 地图目录
DDNET_MAPS_DIR=/opt/ddnet/data/maps

# DDNet RCON (外部控制台) 配置
DDNET_RCON_HOST=127.0.0.1
DDNET_RCON_PORT=8304
DDNET_RCON_PASSWORD=your-rcon-password
